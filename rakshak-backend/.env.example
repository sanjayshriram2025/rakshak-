# --- App ---
APP_NAME=RAKSHAK
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api

# --- Security ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- PostgreSQL ---
POSTGRES_USER=rakshak
POSTGRES_PASSWORD=rakshak_password
POSTGRES_DB=rakshak
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://rakshak:rakshak_password@postgres:5432/rakshak

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rakshak_password

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- File uploads ---
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE_MB=25
